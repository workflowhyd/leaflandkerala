generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum CustomerStatus {
  LEAD
  VISITED
  INTERESTED
  FOLLOW_UP
  ORDER_PLACED
  ACTIVE
}

enum OrderStatus {
  NEW
  CONFIRMED
  PROCESSING
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum ProductCategory {
  SEEDS
  FERTILIZERS
  PESTICIDES
  ORGANIC_PRODUCTS
  FARMING_TOOLS
  IRRIGATION_SUPPLIES
  AGRICULTURAL_EQUIPMENT
  MANGO
  JACKFRUIT
  COCONUT
  SPICES
  ORNAMENTAL_PALMS
  FLOWERS
  INDOOR_PLANTS
  ORNAMENTAL_PLANTS
  TIMBER_TREES
  FRUIT_PLANTS
  GROW_SUPPLIES
}

enum DocumentType {
  AADHAAR
  PAN
  DRIVING_LICENSE
  VOTER_ID
}

enum ActivityType {
  LOGIN
  LOGOUT
  CUSTOMER_REGISTER
  CUSTOMER_VISIT
  PHOTO_UPLOAD
  ORDER_CREATE
  ORDER_STATUS_CHANGE
  EMPLOYEE_CREATE
  EMPLOYEE_DELETE
  PRODUCT_CREATE
  PRODUCT_UPDATE
  RETURN_CREATE
  RETURN_STATUS_CHANGE
}

enum OfferType {
  SIX_MONTHS_BONUS
  BEST_PERFORMER
  MONTHLY_INCENTIVE
  FESTIVAL_BONUS
  REFERRAL_BONUS
  CUSTOM
}

enum TargetGroup {
  ALL
  ACTIVE_ONLY
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ReturnReason {
  DAMAGED_PRODUCT
  WRONG_PRODUCT_DELIVERED
  EXPIRED_PRODUCT
  POOR_QUALITY
  CUSTOMER_CHANGED_MIND
  EXCESS_QUANTITY_ORDERED
  PACKAGING_ISSUE
  OTHER
}

model User {
  id        String   @id
  name      String
  email     String   @unique
  role      Role     @default(EMPLOYEE)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee     Employee?
  activityLogs ActivityLog[]
}

model Employee {
  id                String   @id @default(cuid())
  userId            String   @unique
  name              String
  mobile            String
  email             String
  address           String?
  commissionPercent Float    @default(10.0)
  territory         String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents         EmployeeDocument[]
  pincodes          EmployeePincode[]
  customers         Customer[]
  fieldVisits       FieldVisit[]
  orders            Order[]
  commissions       Commission[]
  locations         EmployeeLocation[]
  rewards           EmployeeReward[]
  payments          EmployeePayment[]
  returns           Return[]
}

model EmployeeDocument {
  id           String       @id @default(cuid())
  employeeId   String
  documentType DocumentType
  imageUrl     String
  publicId     String?
  createdAt    DateTime     @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model EmployeePincode {
  id         String   @id @default(cuid())
  employeeId String
  pincodeId  String
  assignedAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  pincode  Pincode  @relation(fields: [pincodeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, pincodeId])
}

model Pincode {
  id        String   @id @default(cuid())
  code      String   @unique
  area      String?
  district  String?
  state     String   @default("Telangana")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees EmployeePincode[]
  customers Customer[]
  orders    Order[]
}

model Customer {
  id                String         @id @default(cuid())
  employeeId        String
  name              String
  mobile            String
  alternateMobile   String?
  address           String
  village           String?
  district          String
  state             String         @default("Telangana")
  pincode           String
  pincodeId         String?
  landmark          String?
  interestedProduct String?
  notes             String?
  status            CustomerStatus @default(LEAD)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  employee     Employee          @relation(fields: [employeeId], references: [id])
  pincodeRef   Pincode?          @relation(fields: [pincodeId], references: [id])
  photos       CustomerPhoto[]
  location     CustomerLocation?
  fieldVisits  FieldVisit[]
  orders       Order[]
  activityLogs ActivityLog[]
  returns      Return[]

  @@index([employeeId])
  @@index([mobile])
  @@index([status])
}

model CustomerPhoto {
  id         String   @id @default(cuid())
  customerId String
  imageUrl   String
  publicId   String?
  isFront    Boolean  @default(false)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerLocation {
  id         String   @id @default(cuid())
  customerId String   @unique
  latitude   Float
  longitude  Float
  capturedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model FieldVisit {
  id         String   @id @default(cuid())
  employeeId String
  customerId String
  visitDate  DateTime
  notes      String?
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
}

model Product {
  id            String          @id @default(cuid())
  name          String
  category      ProductCategory
  description   String?
  price         Float
  salePrice     Float?
  sku           String          @unique
  serialNumber  Int             @unique @default(dbgenerated("nextval('product_serial_seq'::regclass)"))
  stock         Int             @default(0)
  imageUrl      String?
  imagePublicId String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  orderItems         OrderItem[]
  returnItems        ReturnItem[]
  inventoryMovements InventoryMovement[]

  @@index([name])
  @@index([isActive])
  @@index([category])
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique
  customerId   String
  employeeId   String
  status       OrderStatus @default(NEW)
  totalAmount  Float
  notes        String?
  deliveryDate DateTime?
  pincodeId    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  customer      Customer       @relation(fields: [customerId], references: [id])
  employee      Employee       @relation(fields: [employeeId], references: [id])
  pincodeRef    Pincode?       @relation(fields: [pincodeId], references: [id])
  items         OrderItem[]
  tracking      OrderTracking[]
  notifications Notification[]
  commissions   Commission[]
  returns       Return[]

  @@index([employeeId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  subtotal  Float

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id])
  returnItems ReturnItem[]
}

model OrderTracking {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  notes     String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(cuid())
  orderId   String?
  type      String
  recipient String
  message   String
  isSent    Boolean   @default(false)
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

model DeliverySchedule {
  id             String    @id @default(cuid())
  orderId        String
  scheduledDate  DateTime
  reminderSent   Boolean   @default(false)
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model CommissionSetting {
  id                    String   @id @default(cuid())
  defaultPercentage     Float    @default(10.0)
  minPercentage         Float    @default(5.0)
  maxPercentage         Float    @default(15.0)
  weeklyBonusThreshold  Float    @default(50000)
  weeklyBonusRate       Float    @default(35)
  freeGiftEnabled       Boolean  @default(false)
  freeGiftProductName   String   @default("Free Gift")
  freeGiftMinAmount     Float    @default(3000)
  updatedAt             DateTime @updatedAt
}

model Commission {
  id         String    @id @default(cuid())
  employeeId String
  orderId    String
  amount     Float
  percentage Float
  isPaid     Boolean   @default(false)
  paidAt     DateTime?
  paymentId  String?
  createdAt  DateTime  @default(now())

  employee Employee         @relation(fields: [employeeId], references: [id])
  order    Order            @relation(fields: [orderId], references: [id])
  payment  EmployeePayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
}

model EmployeePayment {
  id               String    @id @default(cuid())
  employeeId       String
  adminId          String
  referenceNumber  String    @unique
  amount           Float
  salesAmount      Float
  commissionAmount Float
  ordersCount      Int       @default(0)
  weekStart        DateTime?
  weekEnd          DateTime?
  notes            String?
  createdAt        DateTime  @default(now())

  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  commissions Commission[]
}

model ActivityLog {
  id          String       @id @default(cuid())
  userId      String?
  customerId  String?
  type        ActivityType
  description String
  metadata    Json?
  createdAt   DateTime     @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model EmployeeLocation {
  id         String   @id @default(cuid())
  employeeId String
  latitude   Float
  longitude  Float
  accuracy   Float?
  capturedAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([capturedAt])
}

model WhatsAppSetting {
  id                  String   @id @default(cuid())
  isEnabled           Boolean  @default(false)
  apiKey              String?
  phoneNumberId       String?
  adminPhone          String?
  templateOrderPlaced String   @default("Your order has been received.")
  templateConfirmed   String   @default("Your order has been confirmed.")
  templateProcessing  String   @default("Your order is being processed.")
  templateDispatched  String   @default("Your order has been dispatched.")
  templateDelivery    String   @default("Your order is out for delivery.")
  templateDelivered   String   @default("Your order has been delivered successfully.")
  templateReminder    String   @default("Dear Customer, your order is scheduled for delivery tomorrow. Please ensure someone is available to receive it.")
  updatedAt           DateTime @updatedAt
}

model CompanyInfo {
  id            String   @id @default(cuid())
  businessName  String   @default("LeafLand Kerala")
  contactNumber String?
  email         String?
  gstNumber     String?
  address       String?
  logoUrl       String?
  logoPublicId  String?
  updatedAt     DateTime @updatedAt
}

model Offer {
  id          String      @id @default(cuid())
  title       String
  description String
  bannerImage String?
  offerType   OfferType   @default(CUSTOM)
  startDate   DateTime    @default(now())
  endDate     DateTime?
  targetGroup TargetGroup @default(ALL)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  rewards EmployeeReward[]
}

model EmployeeReward {
  id         String    @id @default(cuid())
  employeeId String
  offerId    String
  achievedOn DateTime  @default(now())
  claimed    Boolean   @default(false)
  claimedOn  DateTime?
  notified   Boolean   @default(false)
  createdAt  DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  offer    Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([employeeId, offerId])
  @@index([employeeId])
}

model EmployeeRegistrationRequest {
  id                   String             @id @default(cuid())
  fullName             String
  mobileNumber         String
  governmentIdType     DocumentType
  governmentIdImageUrl String
  governmentIdPublicId String?
  status               RegistrationStatus @default(PENDING)
  adminNotes           String?
  submittedAt          DateTime           @default(now())
  approvedAt           DateTime?
  approvedById         String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([mobileNumber])
  @@index([status])
}

model Return {
  id           String       @id @default(cuid())
  returnNumber String       @unique
  orderId      String
  customerId   String
  employeeId   String
  status       ReturnStatus @default(PENDING)
  reason       ReturnReason
  reasonNotes  String?
  notes        String?
  adminNotes   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  order    Order    @relation(fields: [orderId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  items              ReturnItem[]
  images             ReturnImage[]
  inventoryMovements InventoryMovement[]

  @@index([orderId])
  @@index([customerId])
  @@index([employeeId])
  @@index([status])
  @@index([createdAt])
}

model ReturnItem {
  id          String   @id @default(cuid())
  returnId    String
  orderItemId String
  productId   String
  quantity    Int
  createdAt   DateTime @default(now())

  return    Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([productId])
}

model ReturnImage {
  id        String   @id @default(cuid())
  returnId  String
  imageUrl  String
  publicId  String?
  createdAt DateTime @default(now())

  return Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
}

model InventoryMovement {
  id        String   @id @default(cuid())
  productId String
  returnId  String?
  quantity  Int
  reason    String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  return  Return? @relation(fields: [returnId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([returnId])
  @@index([createdAt])
}
